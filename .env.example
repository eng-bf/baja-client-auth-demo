# Base URL of the BF API / Authorization Server.
VITE_BF_API_URL=http://localhost:3000

# The client_id of the OAuth app you registered in the BF developer portal
# (dbsync → Public API → Browser apps → Register app), with redirect URI
# http://localhost:5180/callback and scopes "openid profile public_api:read
# checkin:read" (checkin:read is required for the playground's check-in calls).
VITE_CLIENT_ID=

# Must exactly match a redirect URI registered for the client above.
VITE_REDIRECT_URI=http://localhost:5180/callback

# Space-delimited scopes to request.
VITE_SCOPES=openid profile public_api:read checkin:read
